  m_Script: {fileID: 11500000, guid: d5083eb9383d3a844a18316e8f137b51, type: 3}
  m_Name: Egipcio
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem_V.Dialogue_Round
  dialogueTurnList:
  - <Character>k__BackingField: {fileID: 11400000, guid: c71087bf33da6a543809a16202625822, type: 2}
    dialogue_line: Because you've been in the bathroom for so long, it's a little
      suspicious.
  - <Character>k__BackingField: {fileID: 11400000, guid: f63f9cfa5fa0b714784367e223459cfd, type: 2}
    dialogue_line: I've been looking for my contact lenses for half an hour, I don't
      know where I left them and I can't see anything.
  - <Character>k__BackingField: {fileID: 11400000, guid: c71087bf33da6a543809a16202625822, type: 2}
    dialogue_line: Okay, so you need help, even if it's just holding your drink?
  - <Character>k__BackingField: {fileID: 11400000, guid: f63f9cfa5fa0b714784367e223459cfd, type: 2}
    dialogue_line: No, I'll find them myself, thanks mate. And as for the drink,
      it's been empty for a while.
