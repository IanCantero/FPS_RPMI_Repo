  m_Script: {fileID: 11500000, guid: d5083eb9383d3a844a18316e8f137b51, type: 3}
  m_Name: KillBill
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem_V.Dialogue_Round
  dialogueTurnList:
  - <Character>k__BackingField: {fileID: 11400000, guid: a33df6768348de8448b4896b977c7948, type: 2}
    dialogue_line: Oh, I love your costume, it's from one of my favorite movies,
      you know?
  - <Character>k__BackingField: {fileID: 11400000, guid: c71087bf33da6a543809a16202625822, type: 2}
    dialogue_line: Mine too, I saw it three times the week it premiered three years
      ago.
  - <Character>k__BackingField: {fileID: 11400000, guid: a33df6768348de8448b4896b977c7948, type: 2}
    dialogue_line: Three years ago? How quickly time flies! I can't believe it's
      the year 2000 and we haven't, I don't know, exploded.
  - <Character>k__BackingField: {fileID: 11400000, guid: c71087bf33da6a543809a16202625822, type: 2}
    dialogue_line: Oh yea thats stupid.
  - <Character>k__BackingField: {fileID: 11400000, guid: a33df6768348de8448b4896b977c7948, type: 2}
    dialogue_line: Couldn't agree more.
