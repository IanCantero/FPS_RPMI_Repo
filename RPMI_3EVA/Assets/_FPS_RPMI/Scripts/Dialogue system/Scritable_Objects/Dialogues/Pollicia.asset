  m_Script: {fileID: 11500000, guid: d5083eb9383d3a844a18316e8f137b51, type: 3}
  m_Name: Pollicia
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem_V.Dialogue_Round
  dialogueTurnList:
  - <Character>k__BackingField: {fileID: 11400000, guid: a615352c75e84e148ae1018939a353b2, type: 2}
    dialogue_line: I've been waiting for half an hour and nobody's here, we were
      supposed to play truth or dare, dude
  - <Character>k__BackingField: {fileID: 11400000, guid: c71087bf33da6a543809a16202625822, type: 2}
    dialogue_line: Let's see, supposedly there's a dead person outside the house.
  - <Character>k__BackingField: {fileID: 11400000, guid: a615352c75e84e148ae1018939a353b2, type: 2}
    dialogue_line: Dead? What do I care? I came here to have a good time, not to
      die of boredom.
  - <Character>k__BackingField: {fileID: 11400000, guid: c71087bf33da6a543809a16202625822, type: 2}
    dialogue_line: Yea...What a shame.
